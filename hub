    local MAX_SPEED = 140
    local MIN_SPEED = 30

    local function spawnSmiley()
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, smileyRadius * 2, 0, smileyRadius * 2)
        label.AnchorPoint = Vector2.new(0.5, 0.5)
        label.BackgroundTransparency = 1
        label.Text = "☺"
        label.Font = Enum.Font.FredokaOne
        label.TextSize = math.floor(smileyRadius * 1.8)
        label.TextColor3 = isDarkTheme and Color3.fromRGB(230, 230, 235) or Color3.fromRGB(25, 25, 30)
        label.ZIndex = 2
        label.Parent = SmileyCanvas

        table.insert(registeredThemeElements.Texts, label)

        local maxX = math.max(50, SmileyCanvas.AbsoluteSize.X - smileyRadius)
        local maxY = math.max(50, SmileyCanvas.AbsoluteSize.Y - smileyRadius)

        local angle = math.random() * math.pi * 2
        local baseSpeed = math.random(50, 90)

        local smileyData = {
            Gui = label,
            Pos = Vector2.new(math.random(smileyRadius, maxX), math.random(smileyRadius, maxY)),
            Vel = Vector2.new(math.cos(angle) * baseSpeed, math.sin(angle) * baseSpeed),
            Angle = math.random(0, 360),
            RotSpeed = (math.random() > 0.5 and 1 or -1) * math.random(40, 90)
        }
        table.insert(smileys, smileyData)
    end

    local function removeSmiley()
        if #smileys > 0 then
            local data = table.remove(smileys, #smileys)
            if data and data.Gui then
                data.Gui:Destroy()
            end
        end
    end

    local function setSmileyCount(targetCount)
        targetCount = math.clamp(targetCount, 0, 70)
        while #smileys < targetCount do
            spawnSmiley()
        end
        while #smileys > targetCount do
            removeSmiley()
        end
    end

    local function updateSmileySizes(newRadius)
        smileyRadius = newRadius
        for _, s in ipairs(smileys) do
            s.Gui.Size = UDim2.new(0, smileyRadius * 2, 0, smileyRadius * 2)
            s.Gui.TextSize = math.floor(smileyRadius * 1.8)
        end
    end

    RunService.RenderStepped:Connect(function(dt)
        local bounds = SmileyCanvas.AbsoluteSize
        local mousePos = UserInputService:GetMouseLocation()
        local canvasPos = SmileyCanvas.AbsolutePosition
        local localMouse = Vector2.new(mousePos.X - canvasPos.X, mousePos.Y - canvasPos.Y)
        local mouseRadius = 32

        for _, s in ipairs(smileys) do
            s.Angle = (s.Angle + s.RotSpeed * dt) % 360
            s.Gui.Rotation = s.Angle

            local currentSpeed = s.Vel.Magnitude
            if currentSpeed > MAX_SPEED then
                s.Vel = s.Vel.Unit * MAX_SPEED
            elseif currentSpeed < MIN_SPEED and currentSpeed > 0 then
                s.Vel = s.Vel.Unit * MIN_SPEED
            else
                s.Vel = s.Vel * (1 - 0.2 * dt)
            end

            s.Pos = s.Pos + s.Vel * dt

            if s.Pos.X <= smileyRadius then
                s.Pos = Vector2.new(smileyRadius, s.Pos.Y)
                s.Vel = Vector2.new(math.abs(s.Vel.X), s.Vel.Y)
            elseif s.Pos.X >= bounds.X - smileyRadius then
                s.Pos = Vector2.new(bounds.X - smileyRadius, s.Pos.Y)
                s.Vel = Vector2.new(-math.abs(s.Vel.X), s.Vel.Y)
            end

            if s.Pos.Y <= smileyRadius then
                s.Pos = Vector2.new(s.Pos.X, smileyRadius)
                s.Vel = Vector2.new(s.Vel.X, math.abs(s.Vel.Y))
            elseif s.Pos.Y >= bounds.Y - smileyRadius then
                s.Pos = Vector2.new(s.Pos.X, bounds.Y - smileyRadius)
                s.Vel = Vector2.new(s.Vel.X, -math.abs(s.Vel.Y))
            end

            local dMouse = s.Pos - localMouse
            local distMouse = dMouse.Magnitude
            local hitDist = (smileyRadius * 0.7) + mouseRadius

            if distMouse < hitDist and distMouse > 0 then
                local normal = dMouse.Unit
                local forceFactor = (1 - (distMouse / hitDist))
                s.Vel = s.Vel + normal * (forceFactor * 320 * dt * 60)
            end
        end

        for i = 1, #smileys do
            for j = i + 1, #smileys do
                local s1, s2 = smileys[i], smileys[j]
                local delta = s2.Pos - s1.Pos
                local dist = delta.Magnitude
                local minDist = (smileyRadius * 2) * 0.7

                if dist < minDist and dist > 0 then
                    local normal = delta.Unit
                    local overlap = 0.5 * (minDist - dist)

                    s1.Pos = s1.Pos - normal * overlap
                    s2.Pos = s2.Pos + normal * overlap

                    local v1n = s1.Vel:Dot(normal)
                    local v2n = s2.Vel:Dot(normal)

                    if v1n - v2n > 0 then
                        local impulse = (v1n - v2n) * 0.95
                        s1.Vel = s1.Vel - normal * impulse
                        s2.Vel = s2.Vel + normal * impulse

                        s1.RotSpeed = -s1.RotSpeed
                        s2.RotSpeed = -s2.RotSpeed
                    end
                end
            end
        end

        for _, s in ipairs(smileys) do
            s.Gui.Position = UDim2.new(0, s.Pos.X, 0, s.Pos.Y)
        end
    end)

