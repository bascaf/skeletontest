local function getGuiParent()
    if gethui then
        return gethui()
    elseif syn and syn.protect_gui then
        local gui = Instance.new("Folder")
        syn.protect_gui(gui)
        gui.Parent = CoreGui
        return gui
    end
    return CoreGui
end

local function getAsset(urlOrId)
    if tostring(urlOrId):match("^rbxassetid://") or tostring(urlOrId):match("^%d+$") then
        local id = tostring(urlOrId):gsub("%D", "")
        return "rbxassetid://" .. id
    elseif (tostring(urlOrId):match("^http://") or tostring(urlOrId):match("^https://")) and getcustomasset and writefile then
        local fileName = "custom_asset_" .. string.sub(HttpService:GenerateGUID(false), 1, 8) .. ".png"
        if not isfile(fileName) then
            pcall(function()
                writefile(fileName, game:HttpGet(urlOrId))
            end)
        end
        if isfile(fileName) then
            return getcustomasset(fileName)
        end
    end
    return urlOrId
end

