            Label.TextColor3 = isDarkTheme and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(40, 40, 45)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.ZIndex = 4
            Label.Parent = Frame

            local Switch = Instance.new("TextButton")
            Switch.Size = UDim2.new(0, 42, 0, 20)
            Switch.Position = UDim2.new(1, -50, 0.5, -10)
            Switch.BackgroundColor3 = state and Color3.fromRGB(75, 125, 240) or Color3.fromRGB(50, 52, 60)
            Switch.Text = ""
            Switch.AutoButtonColor = false
            Switch.ZIndex = 4
            Switch.Parent = Frame

            local SwitchCorner = Instance.new("UICorner")
            SwitchCorner.CornerRadius = UDim.new(1, 0)
            SwitchCorner.Parent = Switch

            local Circle = Instance.new("Frame")
            Circle.Size = UDim2.new(0, 16, 0, 16)
            Circle.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Circle.ZIndex = 4
            Circle.Parent = Switch

            local CircleCorner = Instance.new("UICorner")
            CircleCorner.CornerRadius = UDim.new(1, 0)
            CircleCorner.Parent = Circle

            table.insert(registeredThemeElements.Cards, Frame)
            table.insert(registeredThemeElements.Strokes, Stroke)
            table.insert(registeredThemeElements.Texts, Label)

            local function updateToggle()
                state = not state
                TweenService:Create(Switch, TweenInfo.new(0.2), {
                    BackgroundColor3 = state and Color3.fromRGB(75, 125, 240) or (isDarkTheme and Color3.fromRGB(50, 52, 60) or Color3.fromRGB(200, 200, 205))
                }):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {
                    Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
                }):Play()
                pcall(callback, state)
            end

            Switch.MouseButton1Click:Connect(updateToggle)
        end

        function Tab:CreateInput(inputText, placeholder, callback)
            callback = callback or function() end

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 34)
            Frame.BackgroundColor3 = isDarkTheme and Color3.fromRGB(36, 38, 44) or Color3.fromRGB(255, 255, 255)
            Frame.ZIndex = 4
            Frame.Parent = PageScroll

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Stroke = Instance.new("UIStroke")
            Stroke.Color = isDarkTheme and Color3.fromRGB(48, 50, 58) or Color3.fromRGB(220, 220, 225)
            Stroke.Thickness = 1
            Stroke.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.Text = inputText
            Label.Font = Enum.Font.FredokaOne
            Label.TextSize = 13
            Label.TextColor3 = isDarkTheme and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(40, 40, 45)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.ZIndex = 4
            Label.Parent = Frame

            local Box = Instance.new("TextBox")
            Box.Size = UDim2.new(0.45, -10, 0, 24)
            Box.Position = UDim2.new(0.55, 0, 0.5, -12)
            Box.BackgroundColor3 = isDarkTheme and Color3.fromRGB(28, 29, 34) or Color3.fromRGB(240, 240, 245)
            Box.Text = ""
            Box.PlaceholderText = placeholder or "..."
            Box.Font = Enum.Font.FredokaOne
            Box.TextSize = 12
            Box.TextColor3 = isDarkTheme and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(40, 40, 45)
            Box.PlaceholderColor3 = Color3.fromRGB(130, 130, 135)
            Box.ZIndex = 4
            Box.Parent = Frame

            local BoxCorner = Instance.new("UICorner")
            BoxCorner.CornerRadius = UDim.new(0, 4)
            BoxCorner.Parent = Box

            table.insert(registeredThemeElements.Cards, Frame)
            table.insert(registeredThemeElements.Strokes, Stroke)
            table.insert(registeredThemeElements.Texts, Label)

            Box.FocusLost:Connect(function(enterPressed)
                pcall(callback, Box.Text, enterPressed)
            end)
        end

        function Tab:CreateSlider(sliderText, min, max, default, callback)
            callback = callback or function() end
            local value = default or min

            local Frame = Instance.new("Frame")
            Frame.Size = UDim2.new(1, 0, 0, 46)
            Frame.BackgroundColor3 = isDarkTheme and Color3.fromRGB(36, 38, 44) or Color3.fromRGB(255, 255, 255)
            Frame.ZIndex = 4
            Frame.Parent = PageScroll

            local Corner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 6)
            Corner.Parent = Frame

            local Stroke = Instance.new("UIStroke")
            Stroke.Color = isDarkTheme and Color3.fromRGB(48, 50, 58) or Color3.fromRGB(220, 220, 225)
            Stroke.Thickness = 1
            Stroke.Parent = Frame

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.7, 0, 0, 20)
            Label.Position = UDim2.new(0, 10, 0, 2)
            Label.Text = sliderText
            Label.Font = Enum.Font.FredokaOne
            Label.TextSize = 13
            Label.TextColor3 = isDarkTheme and Color3.fromRGB(235, 235, 240) or Color3.fromRGB(40, 40, 45)
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.ZIndex = 4
            Label.Parent = Frame

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Size = UDim2.new(0.3, -10, 0, 20)
            ValLabel.Position = UDim2.new(0.7, 0, 0, 2)
            ValLabel.Text = tostring(value)
            ValLabel.Font = Enum.Font.FredokaOne
            ValLabel.TextSize = 12
            ValLabel.TextColor3 = isDarkTheme and Color3.fromRGB(180, 182, 190) or Color3.fromRGB(70, 70, 75)
            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.BackgroundTransparency = 1
            ValLabel.ZIndex = 4
            ValLabel.Parent = Frame

            local Bar = Instance.new("Frame")
            Bar.Size = UDim2.new(1, -20, 0, 8)
            Bar.Position = UDim2.new(0, 10, 0, 28)
            Bar.BackgroundColor3 = isDarkTheme and Color3.fromRGB(50, 52, 60) or Color3.fromRGB(225, 225, 230)
            Bar.ZIndex = 4
            Bar.Parent = Frame

            local BarCorner = Instance.new("UICorner")
            BarCorner.CornerRadius = UDim.new(1, 0)
            BarCorner.Parent = Bar

            local Fill = Instance.new("Frame")
            local initPercent = math.clamp((value - min) / (max - min), 0, 1)
            Fill.Size = UDim2.new(initPercent, 0, 1, 0)
            Fill.BackgroundColor3 = isDarkTheme and Color3.fromRGB(100, 140, 255) or Color3.fromRGB(80, 80, 85)
            Fill.BorderSizePixel = 0
            Fill.ZIndex = 4
            Fill.Parent = Bar

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            table.insert(registeredThemeElements.Cards, Frame)
            table.insert(registeredThemeElements.Strokes, Stroke)
            table.insert(registeredThemeElements.Texts, Label)
            table.insert(registeredThemeElements.SecondaryTexts, ValLabel)

            local sliding = false
            local function update(input)
                local percent = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                Fill.Size = UDim2.new(percent, 0, 1, 0)
                local currentVal = math.floor(min + (max - min) * percent)
                ValLabel.Text = tostring(currentVal)
                pcall(callback, currentVal)
            end

            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update(input)
                end
            end)
        end

        return Tab
    end

    local SettingsTab = Window:CreateTab("Settings")

    SettingsTab:CreateSlider("Smiley Count:", 0, 70, SettingsData.SmileyCount, function(val)
        SettingsData.SmileyCount = val
        setSmileyCount(val)
        SaveSettings()
    end)
    setSmileyCount(SettingsData.SmileyCount)

    SettingsTab:CreateSlider("Smiley Size:", 8, 75, SettingsData.SmileySize, function(val)
        SettingsData.SmileySize = val
        updateSmileySizes(val)
        SaveSettings()
    end)
    updateSmileySizes(SettingsData.SmileySize)

    SettingsTab:CreateInput("Add BG (ID/URL):", SettingsData.BgId, function(text)
        if text and text ~= "" then
            SettingsData.BgId = text
            CustomBackground.Image = getAsset(text)
            SaveSettings()
        end
    end)
    if SettingsData.BgId and SettingsData.BgId ~= "" then
        CustomBackground.Image = getAsset(SettingsData.BgId)
    end

    SettingsTab:CreateSlider("BG Clarity (%):", 0, 100, SettingsData.BgClarity, function(val)
        SettingsData.BgClarity = val
        CustomBackground.ImageTransparency = (100 - val) / 100
        SaveSettings()
    end)
    CustomBackground.ImageTransparency = (100 - SettingsData.BgClarity) / 100

    SettingsTab:CreateToggle("Dark Theme", SettingsData.DarkTheme, function(state)
        SettingsData.DarkTheme = state
        applyTheme(state)
        SaveSettings()
    end)

    applyTheme(SettingsData.DarkTheme)

    return Window
end

local Window = Library:CreateWindow("Omerica strong")
return Window
